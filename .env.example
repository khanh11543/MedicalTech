# ============================================================
# Khi đặt server ở máy khác: chỉnh toàn bộ trong file .env này.
# Chi tiết từng mục: xem DEPLOY.md
# ============================================================
# 1) MySQL (IP/host máy chạy MySQL)
MYSQL_HOST=192.168.1.100
MYSQL_PORT=1776
MYSQL_DATABASE=medical_appointment_system
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# 2) CORS - thêm URL mà user dùng để mở app (tránh 403 đăng nhập)
#    Ví dụ: http://192.168.1.50:3000 hoặc https://your-domain.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.50,http://192.168.1.50:3000

# 3) URL giao diện (link trong email, redirect)
FRONTEND_URL=http://192.168.1.50:3000

# 4) MoMo production (nếu dùng) - đổi your-domain.com thành domain thật
PROD_MOMO_RETURN_URL=https://your-domain.com/
PROD_MOMO_IPN_URL=https://your-domain.com/api/momo/ipn-handler
