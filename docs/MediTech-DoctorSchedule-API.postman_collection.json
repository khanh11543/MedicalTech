					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"startDate\": \"2026-02-10\",\n  \"endDate\": \"2026-02-17\",\n  \"overwriteExisting\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/doctor/time-slots/generate",
							"host": [
								"{{base_url}}"
							],
							"path": [
