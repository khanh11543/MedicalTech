								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dayOfWeek\": 1,\n  \"startTime\": \"08:00:00\",\n  \"endTime\": \"12:00:00\",\n  \"slotDuration\": 30,\n  \"maxPatients\": 20,\n  \"isActive\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/doctor/schedules",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"doctor",
								"schedules"
							]
						}
					},
					"response": []
				},
				{
					"name": "Create Schedule - Monday Afternoon",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dayOfWeek\": 1,\n  \"startTime\": \"14:00:00\",\n  \"endTime\": \"17:00:00\",\n  \"slotDuration\": 30,\n  \"maxPatients\": 15\n}"
						},
						"url": {
							"raw": "{{base_url}}/doctor/schedules",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"doctor",
								"schedules"
							]
						}
					},
					"response": []
				},
				{
					"name": "List All Schedules",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/doctor/schedules",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"doctor",
								"schedules"
							]
						}
					},
					"response": []
				},
				{
					"name": "List Schedules - Filter by Monday",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/doctor/schedules?dayOfWeek=1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"doctor",
								"schedules"
							],
							"query": [
								{
									"key": "dayOfWeek",
									"value": "1"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Update Schedule",
					"request": {
