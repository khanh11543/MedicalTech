					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/doctor/time-slots?startDate=2026-02-10&endDate=2026-02-17",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"doctor",
								"time-slots"
							],
							"query": [
