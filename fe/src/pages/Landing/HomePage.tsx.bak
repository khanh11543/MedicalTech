// ==================== Find A Doctor Section ====================
function DoctorSection() {
  const doctors = [
    { name: "Dr. Sarah Mitchell", specialty: "Cardiology", exp: "15+ years", rating: 4.9, img: "/images/landing/staff-3.webp", status: "online" as const },
    { name: "Dr. Michael Rodriguez", specialty: "Neurology", exp: "12+ years", rating: 4.7, img: "/images/landing/staff-7.webp", status: "busy" as const },
    { name: "Dr. Emily Chen", specialty: "Pediatrics", exp: "8+ years", rating: 5.0, img: "/images/landing/staff-1.webp", status: "online" as const },
    { name: "Dr. James Thompson", specialty: "Orthopedics", exp: "20+ years", rating: 4.8, img: "/images/landing/staff-9.webp", status: "offline" as const },
    { name: "Dr. Lisa Anderson", specialty: "Dermatology", exp: "10+ years", rating: 4.6, img: "/images/landing/staff-5.webp", status: "online" as const },
    { name: "Dr. Robert Kim", specialty: "Oncology", exp: "18+ years", rating: 4.9, img: "/images/landing/staff-12.webp", status: "online" as const },
  ];

  const statusLabel = {
    online: "Available",
    busy: "In Surgery",
    offline: "Next: Tomorrow 9AM",
  };

  return (
    <section className="py-20">
      <div className="container mx-auto max-w-7xl px-6">
        <SectionTitle
          title="Find A Doctor"
          description="Our team of board-certified specialists is ready to provide you with exceptional care"
        />

        {/* Search */}
        <div className="bg-white rounded-2xl shadow-lg p-6 mb-10">
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            <input
              type="text"
              placeholder="Doctor name or keyword"
              className="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-[#049ebb] focus:border-transparent outline-none"
            />
            <select className="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-[#049ebb] focus:border-transparent outline-none text-gray-500">
              <option value="">Select Specialty</option>
              <option>Cardiology</option>
              <option>Neurology</option>
              <option>Orthopedics</option>
              <option>Pediatrics</option>
              <option>Dermatology</option>
              <option>Oncology</option>
            </select>
            <button className="btn-mt-primary w-full justify-center py-3">
              <i className="bi bi-search"></i>
              Search Doctor
            </button>
          </div>
        </div>

        {/* Doctor Grid */}
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {doctors.map((doc) => (
            <div key={doc.name} className="doctor-card-landing">
              <div className="doctor-img-wrapper">
                <img src={doc.img} alt={doc.name} />
                <div className="doctor-overlay">
                  <a href="#" className="doctor-social-link"><i className="bi bi-linkedin"></i></a>
                  <a href="#" className="doctor-social-link"><i className="bi bi-twitter-x"></i></a>
                  <a href="#" className="doctor-social-link"><i className="bi bi-envelope"></i></a>
                </div>
                <div className={`availability-badge ${doc.status}`}>
                  {statusLabel[doc.status]}
                </div>
              </div>
              <div className="p-5">
                <h5 className="font-bold text-base mb-0.5">{doc.name}</h5>
                <p className="text-[#049ebb] text-sm font-medium mb-1">{doc.specialty}</p>
                <p className="text-gray-400 text-xs mb-2">{doc.exp} experience</p>
                <StarRating rating={doc.rating} />
                <div className="flex gap-2 mt-4">
                  <Link to="/doctors" className="btn-mt-outline text-xs px-4 py-2 no-underline">
                    View Profile
                  </Link>
                  <Link to="/appointment" className="btn-mt-primary text-xs px-4 py-2 no-underline">
                    Book Appointment
                  </Link>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  );
}

