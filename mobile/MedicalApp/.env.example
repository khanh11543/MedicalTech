# --- When do you need a .env file? ---
# If the phone and PC are NOT on the same network (cellular, different Wi‑Fi, isolated VLAN),
# automatic LAN discovery will not work.
# Set a base URL the phone can actually reach (do not use a LAN IP the phone cannot route to).

# Same Wi‑Fi as the PC (LAN): you can leave this empty — the app infers the host from Metro;
# or set it explicitly:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8080/api

# PC and phone on the same Tailscale/ZeroTier: use the virtual IP of the machine running Spring (e.g. 100.x):
# EXPO_PUBLIC_API_BASE_URL=http://100.x.x.x:8080/api

# Metro via tunnel but API on the PC: you still need one of the URLs above (LAN IP if same Wi‑Fi, or Tailscale/ngrok).

# Temporary public backend via ngrok (HTTPS):
# EXPO_PUBLIC_API_BASE_URL=https://xxxx.ngrok-free.app/api

# Spring must listen on 0.0.0.0:8080; open port 8080 in the firewall if needed.
EXPO_PUBLIC_API_BASE_URL=
