# --- Khi nào cần file .env? ---
# Điện thoại và PC KHÔNG cùng mạng (4G, WiFi khác, mạng riêng): tự động LAN không chạy.
# Gán URL mà điện thoại mở được (không dùng IP LAN nội bộ nếu đt không nằm cùng mạng đó).

# Cùng WiFi với PC (LAN): có thể bỏ trống — app lấy IP từ Metro; hoặc gán cố định:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8080/api

# PC + đt cùng Tailscale/ZeroTier: dùng IP ảo của máy chạy Spring (ví dụ 100.x):
# EXPO_PUBLIC_API_BASE_URL=http://100.x.x.x:8080/api

# Metro qua tunnel nhưng API trên PC: vẫn cần một trong các URL trên (LAN IP nếu đt cùng WiFi, hoặc Tailscale/ngrok).

# Backend lộ tạm qua ngrok (HTTPS):
# EXPO_PUBLIC_API_BASE_URL=https://xxxx.ngrok-free.app/api

# Spring phải listen 0.0.0.0:8080; firewall mở 8080 nếu cần.
EXPO_PUBLIC_API_BASE_URL=
